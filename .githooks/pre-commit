#!/usr/bin/env bash
# Comprobacións de calidade antes de cada commit (para Claude e para o modelo local).
# Activar con: git config core.hooksPath .githooks
set -euo pipefail

echo "pre-commit: ruff"
uv run ruff check src tests
echo "pre-commit: mypy"
uv run mypy src
echo "pre-commit: pytest"
uv run pytest -q
